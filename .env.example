# ── Database ─────────────────────────────────────────────
# 本地:postgresql://<user>@localhost:5432/agentum?schema=public
# 生产(Railway):用 Postgres 服务的 DATABASE_URL 引用
DATABASE_URL="postgresql://user@localhost:5432/agentum?schema=public"

# ── Web3 / BSC Testnet (chainId 97) ──────────────────────
NEXT_PUBLIC_CHAIN_ID=97
NEXT_PUBLIC_RPC_URL="https://bsc-testnet-rpc.publicnode.com"
# WalletConnect/Reown projectId(手机扫码需真实值,注入式 MetaMask 用占位也行)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID="your_reown_project_id"

# ── 已部署合约地址(BSC 测试网,公开)────────────────────
NEXT_PUBLIC_AGENT_IDENTITY_ADDRESS="0xD8D7D65841Cbe93B036295A1294253F1cC4D963b"
NEXT_PUBLIC_MOCK_USDT_ADDRESS="0xc4c440d35A0Bd77D84077ec1f7E37aB7873ff307"
NEXT_PUBLIC_JOB_ESCROW_ADDRESS="0xd9DF12Ef8BE51eAb8F8Bc2a302CA321da9707F80"
NEXT_PUBLIC_REPUTATION_ADDRESS="0x86A22cB9D989B7c7Fd3eCDd29e0Ce45AC0e9d55d"

# ── 鉴权 / indexer ───────────────────────────────────────
# SIWE session 签名密钥(生产必须换成强随机值:openssl rand -hex 32)
SESSION_SECRET="change-me-to-a-32-byte-random-hex"
# indexer 状态对账起点(JobEscrow 部署区块)
INDEXER_START_BLOCK=118951200
# 可选:手动触发 /api/indexer 的令牌;不设则该端点无鉴权
# INDEXER_TOKEN=""
# 可选:设为 1 关闭后台 indexer 轮询
# INDEXER_DISABLED=0

# NodeReal archive RPC(服务端用,支持历史 getLogs)。真实 key 只放 .env,别提交!
NODEREAL_BNB_MAINNET=https://bsc-mainnet.nodereal.io/v1/YOUR_NODEREAL_KEY
NODEREAL_BNB_TESTNET=https://bsc-testnet.nodereal.io/v1/YOUR_NODEREAL_KEY